  {"name":"begin-end", "source":"a \"x\\ny\" z\n\"unclosed", "grammar":{"scopeName":"source.test","patterns":[{"begin":"\"","end":"\"","name":"string.quoted","contentName":"string.content","patterns":[{"match":"\\\\.","name":"escape"}]}]}},
