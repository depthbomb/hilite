  "cases": [
    {
      "name": "nested-shadow-and-sibling",
      "source": "a b c",
      "grammar": {
        "scopeName": "source.test",
        "patterns": [
          {
            "patterns": [
              {
                "include": "#local"
              },
              {
                "include": "#sibling"
              }
            ],
            "repository": {
              "local": {
                "match": "a",
                "name": "local.a"
              },
              "sibling": {
                "match": "b",
                "name": "local.b"
              }
            }
          },
          {
            "include": "#local"
          }
        ],
        "repository": {
          "local": {
            "match": "c",
            "name": "root.c"
          }
        }
      },
      "expected": [
        [
          [
            "a",
            [
              "source.test",
              "local.a"
            ]
          ],
          [
            " ",
            [
              "source.test"
            ]
          ],
          [
            "b",
            [
              "source.test",
              "local.b"
            ]
          ],
          [
            " ",
            [
              "source.test"
            ]
          ],
          [
            "c",
            [
              "source.test",
              "root.c"
            ]
          ]
        ]
      ]
    },
    {
      "name": "nested-parent-reference",
      "source": "a b",
      "grammar": {
        "scopeName": "source.test",
        "patterns": [
          {
            "patterns": [
              {
                "include": "#inner"
              }
            ],
            "repository": {
              "inner": {
                "patterns": [
                  {
                    "include": "#outer"
                  },
                  {
                    "include": "#leaf"
                  }
                ],
                "repository": {
                  "leaf": {
                    "match": "b",
                    "name": "nested.b"
                  }
                }
              }
            }
          }
        ],
        "repository": {
          "outer": {
            "match": "a",
            "name": "parent.a"
          }
        }
      },
      "expected": [
        [
          [
            "a",
            [
              "source.test",
              "parent.a"
            ]
          ],
          [
            " ",
            [
              "source.test"
            ]
          ],
          [
            "b",
            [
              "source.test",
              "nested.b"
            ]
          ]
        ]
      ]
    },
    {
      "name": "nested-recursive-includes",
      "source": "(a(a))",
      "grammar": {
        "scopeName": "source.test",
        "patterns": [
          {
            "include": "#outer"
