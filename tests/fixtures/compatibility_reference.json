              "source.test",
              "group",
              "letter"
            ]
          ],
          [
            "(",
            [
              "source.test",
              "group",
              "group"
            ]
          ],
          [
            "a",
            [
              "source.test",
              "group",
              "group",
              "letter"
            ]
          ],
          [
            ")",
            [
              "source.test",
              "group",
              "group"
            ]
          ],
          [
            ")",
            [
              "source.test",
              "group"
            ]
          ]
        ]
      ]
